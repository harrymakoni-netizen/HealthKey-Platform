# Required runtime configuration. Supply values securely; never commit real credentials.
DATABASE_URL=
MAINTENANCE_DATABASE_URL=
AUTH_DATABASE_URL=
NEON_AUTH_COOKIE_SECRET=
APP_BASE_URL=
CRON_SECRET=
DEMO_MODE=true
REQUIRE_MFA=false
OUTBOUND_MESSAGING_ENABLED=false
# Optional explicit database CA; standard public CAs otherwise use verified TLS.
DATABASE_CA_CERT=
# Local legacy Supabase Auth only:
AUTH_URL=
AUTH_API_KEY=
# Local/operator migration tooling only; never retain in released environment:
MIGRATION_DATABASE_URL=
AUTH_ADMIN_KEY=
